{
  "name": "clicker",
  "main": "src/worker/worker.ts",
  "compatibility_date": "2026-09-11",
  // Without this the worker deploys but has no public hostname, and the dashboard toggle
  // silently outlives every deploy. The repository decides, not a checkbox.
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": { "COUNTDOWN_MS": "3000", "ROUND_MS": "10000" }
}
